{
  "name": "carnova-front",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --proxy-config proxy.conf.json",
    "build": "ng build --configuration production",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility",
    "test:visual": "playwright test visual",
    "lighthouse": "node scripts/lighthouse.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"*.{json,ts,mts}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\" \"*.{json,ts,mts}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@fontsource-variable/manrope": "^5.2.0",
    "@stripe/stripe-js": "^8.0.0",
    "rxjs": "~7.8.2",
    "three": "^0.185.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/three": "^0.185.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.0.0",
    "postcss": "^8.5.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "type": "module"
}

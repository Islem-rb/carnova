# Local portfolio only. Compose works without this file using named local demo defaults.
# Copy to .env to override. Never use these placeholders for a public installation.
DATABASE_USER=carnova
DATABASE_PASSWORD=replace-with-your-local-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes-for-local-use
JWT_EXPIRATION_SECONDS=3600
CORS_ORIGINS=http://localhost:8080,http://localhost:4200
FRONTEND_PORT=8080
BACKEND_PORT=8081
DEMO_DATA=true
DEMO_ADMIN_PASSWORD=replace-with-a-local-demo-admin-password
# mock is a local simulation and makes no external payment request.
PAYMENTS_MODE=mock
# Optional TEST mode only; leave empty for mock. No live keys accepted.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional user-managed local Ollama; blank uses the offline guide.
OLLAMA_URL=
OLLAMA_MODEL=llama3.2
# For Maven outside Docker:
DATABASE_URL=jdbc:postgresql://localhost:5432/carnova
UPLOADS_DIR=uploads
MODELS_DIR=models
PORT=8081
